# dependencies
node_modules/

# env files — ignore ALL variants (.env, .env.local, .env.bak, …) except templates.
# NEVER commit real secrets.
.env
.env.*
!.env.example

# Postgres data
.pgdata/
# …but src/data is SOURCE, not a runtime data dir. A bare `data/` matches at any
# depth, so src/data/projects.js was silently never committed — the build then
# had no such file and the container crashed on import at boot.
!src/data/
.dockerdata/
# …but src/data is SOURCE, not a runtime data dir. A bare `data/` matches at any
# depth, so src/data/projects.js was silently never committed — the build then
# had no such file and the container crashed on import at boot.
!src/data/
data/
# …but src/data is SOURCE, not a runtime data dir. A bare `data/` matches at any
# depth, so src/data/projects.js was silently never committed — the build then
# had no such file and the container crashed on import at boot.
!src/data/

# logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# runtime uploads (room photos saved by the bot / LIFF form) — not source
uploads/